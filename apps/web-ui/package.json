{
  "name": "iot-protocol-studio-web-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit --project tsconfig.json && vite build",
    "format": "prettier --write --ignore-path ../../.prettierignore \"src/**/*.{ts,tsx,css}\" index.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check --ignore-path ../../.prettierignore \"src/**/*.{ts,tsx,css}\" index.html package.json tsconfig.json vite.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json --pretty false"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "motion": "^13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-feather": "^2.0.10"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
