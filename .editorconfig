root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,css,html,yml,yaml}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.cmake]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
